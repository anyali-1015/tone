# Copy this file to .env.local and fill in one provider.

# Default: Google Gemini (cheapest tier, has a free allowance).
# Get a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Or any OpenAI-compatible API (OpenAI, DeepSeek, …):
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-nano
# OPENAI_BASE_URL=https://api.openai.com/v1
